{
  "name": "dashboard-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --names server,client --prefix-colors magenta,blue --kill-others \"npm run ai-server\" \"npm run client\"",
    "client": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "ai-server": "mastra dev --dir ai-server/src/mastra",
    "ai-server:typecheck": "tsc -p ai-server/tsconfig.json"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "overrides": {
    "rxjs": "$rxjs",
    "@a2ui/angular": {
      "@angular/core": "$@angular/core",
      "@angular/common": "$@angular/common",
      "@angular/platform-browser": "$@angular/platform-browser"
    },
    "@a2ui/markdown-it": {
      "@a2ui/web_core": "$@a2ui/web_core"
    }
  },
  "dependencies": {
    "@a2ui/agent": "0.1.0",
    "@a2ui/angular": "^0.14.0",
    "@a2ui/markdown-it": "^0.2.2",
    "@a2ui/web_core": "^0.15.0",
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/mastra": "2.0.2",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@copilotkit/angular": "0.6.0",
    "@mastra/core": "^1.82.0",
    "echarts": "^6.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7",
    "zod3": "npm:zod@^3.25.76"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.5",
    "jsdom": "^28.0.0",
    "mastra": "^1.38.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
